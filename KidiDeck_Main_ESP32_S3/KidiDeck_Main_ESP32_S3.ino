  }

  if (wStatus != 0) {
    drawRedLaceBox(46, 162, 228, 48);
    tft.setTextColor(C_DARK_INK);
    tft.drawString(wStatus == 1 ? "You Win! Tap for New" : "Word: " + wTarget + " (Tap)", 160, 186);
