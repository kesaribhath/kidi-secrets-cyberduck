// ---------------- FONT & RLE SPRITE ENGINE ----------------
const uint8_t* activeFontPtr = nullptr;
void useFont(const uint8_t* f) {
  if (activeFontPtr == f) return;
  if (activeFontPtr != nullptr) tft.unloadFont();
  tft.loadFont(f);
  activeFontPtr = f;
}

static uint16_t sprBuf[72 * 72];
static uint16_t spr2xBuf[48 * 48];

void drawRleSprite(int x, int y, int w, int h, const uint16_t* rle, bool useTrans = true) {
  int total = w * h;
  int idx = 0, r = 0;
  while (idx < total) {
    uint16_t cnt = pgm_read_word(&rle[r++]);
    if (cnt == 0) break;
    uint16_t col = pgm_read_word(&rle[r++]);
    int end = min(total, idx + (int)cnt);
    while (idx < end) sprBuf[idx++] = col;
  }
  if (useTrans) tft.pushImage(x, y, w, h, sprBuf, (uint16_t)TR_COL);
  else          tft.pushImage(x, y, w, h, sprBuf);
}

void drawRleSprite2x(int x, int y, int w, int h, const uint16_t* rle) {
  int total = w * h;
  int idx = 0, r = 0;
  while (idx < total) {
    uint16_t cnt = pgm_read_word(&rle[r++]);
    if (cnt == 0) break;
    uint16_t col = pgm_read_word(&rle[r++]);
    int end = min(total, idx + (int)cnt);
    while (idx < end) sprBuf[idx++] = col;
  }
  int w2 = w * 2, h2 = h * 2;
  for (int yy = 0; yy < h; yy++) {
    for (int xx = 0; xx < w; xx++) {
      uint16_t c = sprBuf[yy * w + xx];
      int ox = xx * 2, oy = yy * 2;
      spr2xBuf[oy * w2 + ox] = c;
      spr2xBuf[oy * w2 + ox + 1] = c;
      spr2xBuf[(oy + 1) * w2 + ox] = c;
      spr2xBuf[(oy + 1) * w2 + ox + 1] = c;
    }
  }
  tft.pushImage(x, y, w2, h2, spr2xBuf, (uint16_t)TR_COL);
}

void drawRleWallpaper() {
#if HAS_CUSTOM_WALLPAPER
  static uint16_t rowBuf[320];
  int r = 0, rx = 0, ry = 0;
  tft.startWrite();
  while (ry < 240) {
    uint16_t cnt = pgm_read_word(&WALL_RLE[r++]);
    if (cnt == 0) break;
    uint16_t col = pgm_read_word(&WALL_RLE[r++]);
    while (cnt > 0 && ry < 240) {
      int take = min((int)cnt, 320 - rx);
      for (int i = 0; i < take; i++) rowBuf[rx + i] = col;
      rx += take;
      cnt -= take;
      if (rx >= 320) {
        tft.pushImage(0, ry, 320, 1, rowBuf);
        tft.waitDMA();
        rx = 0;
        ry++;
      }
    }
  }
  tft.endWrite();
#else
  tft.fillScreen(C_PURPLE_BG);
#endif
}

void drawFittedText(String s, int x, int y, int maxW, decltype(MC_DATUM) datum) {
  tft.setTextDatum(datum);
  bool trimmed = false;
  while (s.length() > 1 && tft.textWidth(s) > maxW) {
    s.remove(s.length() - 1);
    trimmed = true;
  }
  if (trimmed && s.length() > 2) {
    s.remove(s.length() - 2);
    s += "..";
  }
  tft.drawString(s, x, y);
}

void drawWrappedText(const String& text, int x, int y, int maxW, int lineH, int maxLines) {
  tft.setTextDatum(TL_DATUM);
  int line = 0, pos = 0, len = text.length();
  while (pos < len && line < maxLines) {
    int nl = text.indexOf('\n', pos);
    int limit = (nl >= 0) ? nl : len;
    int end = pos;
    int lastSpace = -1;
    while (end < limit) {
      if (text[end] == ' ') lastSpace = end;
      if (tft.textWidth(text.substring(pos, end + 1)) > maxW) break;
      end++;
    }
    if (end < limit && lastSpace > pos) end = lastSpace;
    if (end == pos && pos < limit) end = pos + 1;
    tft.drawString(text.substring(pos, end), x, y + line * lineH);
    pos = end;
    while (pos < limit && text[pos] == ' ') pos++;
    if (nl >= 0 && pos == nl) pos++;
    line++;
  }
}

void enterSleepMode() {
  tft.fillRoundRect(46, 94, 228, 52, 12, C_DARK_INK);
  tft.drawRoundRect(46, 94, 228, 52, 12, C_SUN_YELLOW);
  useFont(FREDOKA_SM);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(TFT_WHITE);
  tft.drawString("Sleeping... Press BOOT to wake", 160, 120);
  delay(800);
  while (digitalRead(0) == LOW) delay(20);
  delay(80);
  tft.setBrightness(0);
  tft.sleep();
  esp_now_deinit();
  WiFi.disconnect(true);
  WiFi.mode(WIFI_OFF);
  esp_sleep_enable_ext0_wakeup(GPIO_NUM_0, 0);
  esp_deep_sleep_start();
}

