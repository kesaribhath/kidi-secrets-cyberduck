bool syncWifiTime() {
  if (strlen(WIFI_SSID) == 0) return false;
  useFont(FREDOKA_SM);
  tft.fillRoundRect(48, 92, 224, 56, 10, TFT_WHITE);
  tft.drawRoundRect(48, 92, 224, 56, 10, C_SKY_LACE);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(C_DARK_INK);
  tft.drawString("Connecting WiFi NTP...", 160, 120);

  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(false);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  uint32_t start = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - start < 4500) delay(120);
  bool ok = false;
  if (WiFi.status() == WL_CONNECTED) {
    configTime(GMT_OFFSET_SEC, 0, "pool.ntp.org", "time.nist.gov");
    struct tm ti;
    uint32_t ntpStart = millis();
    while (!getLocalTime(&ti, 250) && millis() - ntpStart < 3500) delay(100);
    if (getLocalTime(&ti, 50)) {
      ok = true; wifiSynced = true;
      curYear = ti.tm_year + 1900; curMonth = ti.tm_mon + 1; curDay = ti.tm_mday;
      calViewYear = curYear; calViewMonth = curMonth;
      prefs.putInt("cy", curYear); prefs.putInt("cm", curMonth); prefs.putInt("cd", curDay);
      prefs.putULong64("epoch", (uint64_t)mktime(&ti));
      char b[16]; snprintf(b, sizeof(b), "%02d:%02d Synced", ti.tm_hour, ti.tm_min);
      lastSyncStr = String(b);
    }
  }
  WiFi.disconnect(false);
  esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE);
  return ok;
}

