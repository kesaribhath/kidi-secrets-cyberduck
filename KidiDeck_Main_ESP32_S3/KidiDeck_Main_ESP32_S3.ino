}

void registerCapsuleIndex(const String& key) {
  String list = prefs.getString("caplist", "");
  if (list.indexOf(key) < 0) {
    if (list.length() > 0) list += ",";
    list += key;
    prefs.putString("caplist", list);
  }
}

void saveContacts() {
  prefs.putInt("ccnt", contactCount);
  for (int i = 0; i < contactCount; i++) {
    String p = "c" + String(i);
    prefs.putString((p + "n").c_str(), contacts[i].name);
    prefs.putString((p + "b").c_str(), contacts[i].bday);
    prefs.putString((p + "p").c_str(), contacts[i].phone);
    prefs.putString((p + "o").c_str(), contacts[i].note);
  }
}

void loadContacts() {
  contactCount = prefs.getInt("ccnt", 0);
  if (contactCount <= 0 || contactCount > 6) {
    contactCount = 3;
    contacts[0] = {"My Info", "12/09/2012", "+1 847 400", "My KidiCyberdeck!"};
    contacts[1] = {"Manju", "01/01/2012", "987654321", "hihi"};
    contacts[2] = {"Ojaswi", "14/05/2012", "987650011", "Bestie forever!"};
    saveContacts();
  } else {
    for (int i = 0; i < contactCount; i++) {
      String p = "c" + String(i);
      contacts[i].name  = prefs.getString((p + "n").c_str(), "Friend");
      contacts[i].bday  = prefs.getString((p + "b").c_str(), "01/01/2012");
      contacts[i].phone = prefs.getString((p + "p").c_str(), "");
      contacts[i].note  = prefs.getString((p + "o").c_str(), "");
    }
  }
}

