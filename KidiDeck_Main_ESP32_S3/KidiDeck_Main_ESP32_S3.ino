    tft.setTextDatum(MC_DATUM);
    tft.setTextColor(0x6B4D);
    tft.drawString("No Time Capsules yet!", 160, 96);
    tft.drawString("Pick any entry & open date below", 160, 120);
  } else {
    int row = 0, start = 0;
    while (start < (int)list.length() && row < 3) {
      int comma = list.indexOf(',', start);
      if (comma < 0) comma = list.length();
      String k = list.substring(start, comma);
      start = comma + 1;
      long unlock = prefs.getLong((k + "u").c_str(), 0);
      if (unlock <= 0) continue;
      int ey = k.substring(1, 5).toInt();
      int em = k.substring(5, 7).toInt();
      int ed = k.substring(7, 9).toInt();
      int ry = 52 + row * 42;
      bool sealed = unlock > todayInt;
      tft.fillRoundRect(26, ry, 268, 36, 8, sealed ? 0xFEF0 : 0xDFDF);
      tft.drawRoundRect(26, ry, 268, 36, 8, sealed ? C_AMBER : C_GREEN_OK);
      tft.setTextDatum(ML_DATUM);
      tft.setTextColor(C_DARK_INK);
      int uy = (unlock / 10000L) % 100L;
      int um = (unlock / 100L) % 100L;
      int ud = unlock % 100L;
      char lbl[32];
      snprintf(lbl, sizeof(lbl), "%02d/%02d/%02d -> %02d/%02d/%02d", em, ed, ey % 100, um, ud, uy);
      tft.drawString(lbl, 36, ry + 18);
      tft.setTextDatum(MR_DATUM);
      tft.setTextColor(sealed ? C_HEART_RED : C_GREEN_OK);
      tft.drawString(sealed ? "SEALED" : "OPEN!", 284, ry + 18);
      row++;
    }
  }

  tft.fillRoundRect(56, 184, 208, 30, 8, C_HEART_RED);
  tft.drawRoundRect(56, 184, 208, 30, 8, C_DARK_INK);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(TFT_WHITE);
  tft.drawString("+ Seal Any Entry", 160, 199);
}

