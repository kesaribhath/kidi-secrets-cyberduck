  tft.setTextColor(C_HEART_RED);
  tft.drawString("Time Capsules", 74, 33);

  String list = prefs.getString("caplist", "");
  int cy, cm, cd, hh, mm, dow;
  getCurrentDate(cy, cm, cd, hh, mm, dow);
