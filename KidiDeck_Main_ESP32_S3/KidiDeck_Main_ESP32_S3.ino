void getCurrentDate(int &y, int &m, int &d, int &hh, int &mm, int &dow) {
  struct tm ti;
  if (getLocalTime(&ti, 5)) {
    y = ti.tm_year + 1900; m = ti.tm_mon + 1; d = ti.tm_mday;
    hh = ti.tm_hour; mm = ti.tm_min; dow = ti.tm_wday;
  } else {
    y = curYear; m = curMonth; d = curDay;
    uint32_t mins = (millis() / 60000UL) + 20 * 60 + 2;
    hh = (mins / 60) % 24; mm = mins % 60;
    struct tm t = {0};
    t.tm_year = y - 1900; t.tm_mon = m - 1; t.tm_mday = d;
    mktime(&t);
    dow = t.tm_wday;
  }
}

int daysInMonth(int y, int m) {
  static const int dm[12] = {31,28,31,30,31,30,31,31,30,31,30,31};
  if (m == 2 && ((y % 4 == 0 && y % 100 != 0) || (y % 400 == 0))) return 29;
  return dm[m - 1];
}

int firstWeekdayOfMonth(int y, int m) {
  struct tm t = {0};
  t.tm_year = y - 1900; t.tm_mon = m - 1; t.tm_mday = 1;
  mktime(&t);
  return t.tm_wday;
}

long dateToInt(int y, int m, int d) {
  return (long)y * 10000L + (long)m * 100L + (long)d;
}

long addDaysToDateInt(int y, int m, int d, int addDays) {
  struct tm t = {0};
  t.tm_year = y - 1900; t.tm_mon = m - 1; t.tm_mday = d + addDays;
  mktime(&t);
  return dateToInt(t.tm_year + 1900, t.tm_mon + 1, t.tm_mday);
}

void shiftYMD(int &y, int &m, int &d, int dy, int dm, int dd) {
  y = constrain(y + dy, 2020, 2099);
  m += dm;
  if (m < 1) { m = 12; y = max(2020, y - 1); }
  if (m > 12) { m = 1; y = min(2099, y + 1); }
  int maxD = daysInMonth(y, m);
  d += dd;
  if (d < 1) d = maxD;
  if (d > maxD) d = 1;
}

String fmtDateInt(long di) {
  int y = di / 10000L;
  int m = (di / 100L) % 100L;
  int d = di % 100L;
  char buf[16];
  snprintf(buf, sizeof(buf), "%02d/%02d/%04d", m, d, y);
  return String(buf);
}

int readBatteryPct() {
  uint32_t mv = analogReadMilliVolts(BAT_ADC_PIN) * 2;
  if (mv < 2500) return 100;
  return map((long)constrain((int)mv, 3300, 4200), 3300, 4200, 0, 100);
}

bool readMainRawValidated(uint16_t &rx, uint16_t &ry, int samples = 2) {
#ifdef BOARD_ES3C28P_S3
  (void)samples;
  return tft.getTouchRaw(&rx, &ry);
#else
  uint32_t sx = 0, sy = 0;
  uint16_t prevX = 0, prevY = 0;
  for (int i = 0; i < samples; i++) {
    uint16_t x = 0, y = 0;
    if (!tft.getTouchRaw(&x, &y)) return false;
    if (x <= 80 || x >= 4015 || y <= 80 || y >= 4015) return false;
    if (i > 0) {
      if (abs((int)x - (int)prevX) > 260 || abs((int)y - (int)prevY) > 260) return false;
    }
    prevX = x; prevY = y;
    sx += x; sy += y;
    if (i + 1 < samples) delay(5);
  }
  rx = (uint16_t)(sx / samples);
  ry = (uint16_t)(sy / samples);
  return true;
#endif
}

bool waitMainSingleTap(uint16_t &rx, uint16_t &ry, bool autoProbeBus) {
  uint16_t dummyX = 0, dummyY = 0;
#ifdef BOARD_ES3C28P_S3
  (void)autoProbeBus;
  while (tft.getTouchRaw(&dummyX, &dummyY)) delay(20);
  while (true) {
    if (digitalRead(0) == LOW) return false;
    if (tft.getTouchRaw(&rx, &ry)) {
      uint16_t sx = rx, sy = ry;
      delay(70);
      while (tft.getTouchRaw(&dummyX, &dummyY)) delay(20);
      rx = sx; ry = sy;
      return true;
    }
    delay(18);
  }
#else
  uint32_t relStart = millis();
  while (millis() - relStart < 800) {
    if (!tft.getTouchRaw(&dummyX, &dummyY) || dummyX <= 80 || dummyX >= 4015) break;
    delay(20);
  }
  uint8_t probeBus = mainTouchBus;
  while (true) {
    if (digitalRead(0) == LOW) return false;
    if (autoProbeBus) {
      probeBus = (probeBus + 1) & 1;
      tft.selectTouchBus(probeBus);
    }
    if (readMainRawValidated(rx, ry, autoProbeBus ? 4 : 3)) {
      if (autoProbeBus) {
        mainTouchBus = probeBus;
        tft.selectTouchBus(mainTouchBus);
      }
      uint32_t waitRel = millis();
      while (millis() - waitRel < 1500 && tft.getTouchRaw(&dummyX, &dummyY) && dummyX > 80 && dummyX < 4015) {
        delay(20);
      }
      delay(60);
      return true;
    }
    delay(18);
  }
#endif
}

bool getMainTouch(int &tx, int &ty) {
  uint16_t rx = 0, ry = 0;
  if (!readMainRawValidated(rx, ry, 2)) return false;
  int rawX = mainCalSwap ? (int)ry : (int)rx;
  int rawY = mainCalSwap ? (int)rx : (int)ry;
  tx = constrain((int)map(rawX, mainX1, mainX2, 36, 284), 0, 319);
  ty = constrain((int)map(rawY, mainY1, mainY2, 36, 204), 0, 239);
  return true;
}

void runTouchCalibration() {
  pinMode(0, INPUT_PULLUP);
#ifndef BOARD_ES3C28P_S3
  tft.initAllTouchBuses();
#endif
  uint16_t rx1 = 0, ry1 = 0, rx2 = 0, ry2 = 0, rx3 = 0, ry3 = 0;

  tft.fillScreen(C_PURPLE_BG);
  useFont(FREDOKA_MD);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(TFT_WHITE);
  tft.drawString("Touch Screen Align (1/3)", 160, 96);
  useFont(FREDOKA_SM);
  tft.drawString("Tap the RED circle (Top-Left)", 160, 122);
  tft.setTextColor(C_SUN_YELLOW);
#ifdef BOARD_ES3C28P_S3
  tft.drawString("Aligns capacitive touch & fixes mirror", 160, 148);
#else
  tft.drawString("Auto-detecting 25/32/39 & 14/13/12...", 160, 148);
#endif
  tft.setTextColor(0xD69A);
  tft.drawString("(Press BOOT button to skip)", 160, 174);
  tft.fillCircle(36, 36, 15, TFT_RED);
  tft.drawCircle(36, 36, 17, TFT_WHITE);
  if (!waitMainSingleTap(rx1, ry1, true)) {
#ifndef BOARD_ES3C28P_S3
    tft.selectTouchBus(mainTouchBus);
#endif
    return;
  }

  tft.fillScreen(C_PURPLE_BG);
  useFont(FREDOKA_MD);
  tft.setTextColor(TFT_WHITE);
  tft.drawString("Touch Screen Align (2/3)", 160, 96);
  useFont(FREDOKA_SM);
  tft.drawString("Tap the BLUE circle (Top-Right)", 160, 122);
  tft.setTextColor(C_SUN_YELLOW);
#ifndef BOARD_ES3C28P_S3
  tft.drawString(mainTouchBus == 0 ? "Detected Bus: 25/32/39" : "Detected Bus: 14/13/12", 160, 150);
#endif
  tft.fillCircle(284, 36, 15, C_SKY_LACE);
  tft.drawCircle(284, 36, 17, TFT_WHITE);
  if (!waitMainSingleTap(rx2, ry2, false)) return;

  tft.fillScreen(C_PURPLE_BG);
  useFont(FREDOKA_MD);
  tft.setTextColor(TFT_WHITE);
  tft.drawString("Touch Screen Align (3/3)", 160, 96);
  useFont(FREDOKA_SM);
  tft.drawString("Tap the GREEN circle (Bottom-Right)", 160, 122);
  tft.fillCircle(284, 204, 15, C_GREEN_OK);
  tft.drawCircle(284, 204, 17, TFT_WHITE);
  if (!waitMainSingleTap(rx3, ry3, false)) return;

  mainCalSwap = abs((int)ry2 - (int)ry1) > abs((int)rx2 - (int)rx1);
  if (mainCalSwap) {
    mainX1 = (int16_t)ry1; mainX2 = (int16_t)ry2;
    mainY1 = (int16_t)rx2; mainY2 = (int16_t)rx3;
  } else {
    mainX1 = (int16_t)rx1; mainX2 = (int16_t)rx2;
    mainY1 = (int16_t)ry2; mainY2 = (int16_t)ry3;
  }
#ifdef BOARD_ES3C28P_S3
  if (abs(mainX2 - mainX1) < 30) mainX2 = mainX1 + 248;
  if (abs(mainY2 - mainY1) < 30) mainY2 = mainY1 + 168;
#else
  if (abs(mainX2 - mainX1) < 200) mainX2 = mainX1 + 2600;
  if (abs(mainY2 - mainY1) < 200) mainY2 = mainY1 + 2600;
#endif

  prefs.putBool("tcal3", true);
  prefs.putUChar("tbus", mainTouchBus);
  prefs.putBool("tswap", mainCalSwap);
  prefs.putShort("tx1", mainX1); prefs.putShort("tx2", mainX2);
  prefs.putShort("ty1", mainY1); prefs.putShort("ty2", mainY2);
