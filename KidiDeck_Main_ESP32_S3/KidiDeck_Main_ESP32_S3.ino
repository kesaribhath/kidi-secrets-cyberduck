  useFont(FREDOKA_SM);
  for (int r = 0; r < 6; r++) {
    for (int c = 0; c < 5; c++) {
      int bx = 104 + c * 23, by = 28 + r * 21;
      uint16_t col = TFT_WHITE;
      char ch = ' ';
      if (r < wRow) {
        ch = wGuesses[r][c];
        if (ch == wTarget[c]) col = C_GREEN_OK;
        else if (wTarget.indexOf(ch) >= 0) col = C_AMBER;
