void startChess() {
  const int8_t back[8] = {4,2,3,5,6,3,2,4};
  for (int r = 0; r < 8; r++) for (int c = 0; c < 8; c++) chessBoard[r][c] = 0;
  for (int c = 0; c < 8; c++) {
    chessBoard[0][c] = -back[c]; chessBoard[1][c] = -1;
    chessBoard[6][c] = 1;        chessBoard[7][c] = back[c];
  }
  chessSelR = -1; chessSelC = -1; chessStatus = "Your Turn";
}

// Draw clean crisp silhouette Chess Pieces (1=Pawn,2=Knight,3=Bishop,4=Rook,5=Queen,6=King)
void drawChessPieceShape(int x, int y, int8_t p) {
  int t = abs(p);
  uint16_t fill = (p > 0) ? TFT_WHITE : C_DARK_INK;
  uint16_t edge = (p > 0) ? 0x1E8F    : C_AMBER;
  int cx = x + 13, cy = y + 13;
  // Shared pedestal
  tft.fillRect(cx - 7, y + 20, 14, 3, fill);
  tft.drawRect(cx - 7, y + 20, 14, 3, edge);
  if (t == 1) { // Pawn
    tft.fillCircle(cx, y + 8, 4, fill); tft.drawCircle(cx, y + 8, 4, edge);
    tft.fillTriangle(cx - 5, y + 20, cx + 5, y + 20, cx, y + 11, fill);
    tft.drawTriangle(cx - 5, y + 20, cx + 5, y + 20, cx, y + 11, edge);
  } else if (t == 4) { // Rook
    tft.fillRect(cx - 6, y + 6, 3, 4, fill); tft.fillRect(cx - 1, y + 6, 3, 4, fill); tft.fillRect(cx + 4, y + 6, 3, 4, fill);
    tft.fillRect(cx - 5, y + 9, 10, 11, fill); tft.drawRect(cx - 5, y + 9, 10, 11, edge);
  } else if (t == 2) { // Knight
    tft.fillTriangle(cx - 4, y + 20, cx + 5, y + 20, cx + 2, y + 7, fill);
    tft.fillCircle(cx - 1, y + 9, 4, fill); tft.drawCircle(cx - 1, y + 9, 4, edge);
    tft.fillTriangle(cx - 6, y + 11, cx, y + 6, cx + 1, y + 12, fill);
  } else if (t == 3) { // Bishop
    tft.fillCircle(cx, y + 5, 2, fill);
    tft.fillEllipse(cx, y + 13, 5, 6, fill); tft.drawEllipse(cx, y + 13, 5, 6, edge);
  } else if (t == 5) { // Queen
    tft.fillCircle(cx - 5, y + 6, 2, fill); tft.fillCircle(cx, y + 5, 2, fill); tft.fillCircle(cx + 5, y + 6, 2, fill);
    tft.fillTriangle(cx - 6, y + 8, cx + 6, y + 8, cx, y + 20, fill);
    tft.drawTriangle(cx - 6, y + 8, cx + 6, y + 8, cx, y + 20, edge);
  } else { // King
    tft.fillRect(cx - 1, y + 3, 2, 6, edge); tft.fillRect(cx - 3, y + 5, 6, 2, edge);
    tft.fillRoundRect(cx - 6, y + 9, 12, 11, 3, fill); tft.drawRoundRect(cx - 6, y + 9, 12, 11, 3, edge);
  }
}

